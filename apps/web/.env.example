# Neon: pooled connection (host contains "-pooler") for the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: direct connection for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated GitHub logins that become ADMIN on sign-in
ADMIN_GITHUB_LOGINS="your-github-login"
# Optional: only members of this GitHub org may sign in
ALLOWED_GITHUB_ORG=""
